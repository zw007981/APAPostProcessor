{
    "algorithm": "ilqr",
    "outer_row_num": 2,
    "esdf": {
        "active_circle_skip": true
    },
    "solver": {
        "inner": {
            "cost_change_tol": 1e-06,
            "gradient_tol": 1e-05,
            "merit_mu_max": 1000.0,
            "merit_mu_al_ratio": 0.001,
            "gain_reuse_consecutive_limit": 1,
            "gain_reuse_reject_limit": 8,
            "use_virtual_control": true
        },
        "outer": {
            "max_outer_iterations": 30,
            "mu_growth_factor": 3.0,
            "anneal_gamma": 0.3,
            "amplitude_mu_per_element_stage_two": true,
            "esdf_scale_growth": 1.5,
            "esdf_scale_max": 50.0
        }
    },
    "post_stage": {
        "stage_two_min_tracking_weight": 0.015,
        "skip_stage_two_when_weight_exhausted": true
    },
    "dual_candidate_select": false,
    "rs_shortcut": {
        "cap_ratio": 0.9
    }
}
